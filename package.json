{
  "name": "raven61-web-driver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web driver / configurator for the Raven61 hall-effect keyboard (WebHID)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json",
    "pcap": "node tools/pcap/extract.mjs",
    "check": "node tools/check/run.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/w3c-web-hid": "^1.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.3",
    "vite": "^6.3.5"
  }
}
